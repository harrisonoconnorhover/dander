{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["deployment", "profile", "image", "serviceAccount", "pipelines"],
  "properties": {
    "deployment": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(?::[0-9]{1,5})?/[A-Za-z0-9._/-]+@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "existingSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string"}}
    },
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
    "configMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keepOnUninstall"],
      "properties": {"keepOnUninstall": {"type": "boolean"}}
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {"create": {"type": "boolean"}}
    },
    "pipelines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/definitions/pipeline"}
    }
  },
  "definitions": {
    "nameValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {"name": {"type": "string"}, "value": {"type": "string"}}
    },
    "secretValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {"name": {"type": "string"}, "key": {"type": "string"}}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "additionalProperties": {"type": "string"}},
        "limits": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceName", "command", "environment", "secretEnvironment", "schedule",
        "timeZone", "suspend", "backoffLimit", "activeDeadlineSeconds",
        "ttlSecondsAfterFinished", "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit", "resources", "labels"
      ],
      "properties": {
        "resourceName": {"type": "string", "maxLength": 52},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "environment": {"type": "array", "items": {"$ref": "#/definitions/nameValue"}},
        "secretEnvironment": {"type": "array", "items": {"$ref": "#/definitions/secretValue"}},
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string", "minLength": 1},
        "suspend": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 10},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 60},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "resources": {"$ref": "#/definitions/resources"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
