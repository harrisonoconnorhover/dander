{
  "schema": "io.dander.runtime.compatibility/v1",
  "state_warehouse_pairs": [
    {
      "state": "bigquery",
      "warehouse": "bigquery",
      "status": "supported",
      "reason": "Released GCP profile with destination-side BigQuery fencing."
    },
    {
      "state": "bigquery",
      "warehouse": "postgresql",
      "status": "experimental",
      "reason": "Locally conformance-tested with destination-side PostgreSQL fencing; no live hosted profile is qualified."
    },
    {
      "state": "bigquery",
      "warehouse": "redshift",
      "status": "experimental",
      "reason": "Locally conformance-tested with destination-side Redshift fencing; no live hosted profile is qualified."
    },
    {
      "state": "bigquery",
      "warehouse": "snowflake",
      "status": "experimental",
      "reason": "Snowflake staged scalar writer modes and destination fencing pass local conformance; no live Snowflake profile is qualified."
    },
    {
      "state": "postgresql",
      "warehouse": "bigquery",
      "status": "unsupported",
      "reason": "PostgreSQL state with BigQuery execution remains unavailable until every BigQuery write mode uses the destination-side target fence."
    },
    {
      "state": "postgresql",
      "warehouse": "postgresql",
      "status": "experimental",
      "reason": "Local native-profile conformance passed; Kubernetes live qualification remains pending."
    },
    {
      "state": "postgresql",
      "warehouse": "redshift",
      "status": "experimental",
      "reason": "Locally conformance-tested with destination-side Redshift fencing; no live hosted profile is qualified."
    },
    {
      "state": "postgresql",
      "warehouse": "snowflake",
      "status": "experimental",
      "reason": "Cross-backend execution is admitted only for locally conformance-tested Snowflake staged scalar writes; live qualification remains pending."
    }
  ],
  "warehouses": [
    {
      "provider": "bigquery",
      "write_modes": ["incremental", "replace", "scd1", "scd2", "snapshot"],
      "transports": ["load_job", "storage_write"],
      "logical_types": ["array", "binary", "boolean", "date", "decimal", "float", "integer", "json", "record", "string", "time", "timestamp"],
      "max_decimal_precision": 38,
      "max_temporal_precision": 6,
      "supports_transforms": true,
      "supports_graphs": true,
      "supports_target_fencing": true,
      "limitations": ["nested arrays are not supported"]
    },
    {
      "provider": "postgresql",
      "write_modes": ["scd1"],
      "transports": ["copy"],
      "logical_types": ["array", "binary", "boolean", "date", "decimal", "float", "integer", "json", "record", "string", "time", "timestamp"],
      "max_decimal_precision": 1000,
      "max_temporal_precision": 6,
      "supports_transforms": true,
      "supports_graphs": false,
      "supports_target_fencing": true,
      "limitations": ["graph execution is not available", "only scd1 ingestion is implemented"]
    },
    {
      "provider": "redshift",
      "write_modes": ["incremental", "replace", "scd1", "scd2", "snapshot"],
      "transports": ["copy", "direct"],
      "logical_types": ["binary", "boolean", "date", "decimal", "float", "integer", "string", "time", "timestamp"],
      "max_decimal_precision": 38,
      "max_temporal_precision": 6,
      "supports_transforms": true,
      "supports_graphs": true,
      "supports_target_fencing": true,
      "limitations": ["JSON requires the explicit redshift/fallback=super field extension", "direct thresholds default to disabled until the live crossover is measured", "graph safe-cast semantics are not available"]
    },
    {
      "provider": "snowflake",
      "write_modes": ["incremental", "replace", "scd1", "scd2", "snapshot"],
      "transports": ["copy", "direct"],
      "logical_types": ["binary", "boolean", "date", "decimal", "float", "integer", "string", "time", "timestamp"],
      "max_decimal_precision": 38,
      "max_temporal_precision": 9,
      "supports_transforms": true,
      "supports_graphs": true,
      "supports_target_fencing": true,
      "limitations": ["JSON requires the explicit snowflake/fallback=variant field extension", "direct thresholds remain disabled until the live crossover is measured", "hosted source execution selects scd1"]
    }
  ]
}
